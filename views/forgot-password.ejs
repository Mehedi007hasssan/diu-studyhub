<%- include('partials/header') %>

<div class="auth">
  <h1>Forgot password</h1>
  <p class="muted">Enter your registered email address and we will send you a <strong>6-digit recovery code</strong> to reset your password.</p>

  <% if (error) { %>
    <div class="notice bad"><%= error %></div>
  <% } %>

  <form class="form" action="/forgot-password" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Your registered email
      <input type="email" name="email" required autocomplete="email" placeholder="student@diu.edu.bd" value="<%= email || '' %>">
    </label>

    <button class="btn" type="submit" style="width: 100%;">Send Recovery Code</button>
  </form>

  <p class="muted" style="margin-top: 20px;">Remembered your password? <a href="/login">Back to Log in</a>.</p>
</div>

<%- include('partials/footer') %>
