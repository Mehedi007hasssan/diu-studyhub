<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Admin</h1>
    <p class="muted">Manage people, departments and courses.</p>
  </div>
  <a class="btn btn-ghost" href="/mod">Open moderation queue</a>
</div>

<% if (msg) { %><div class="notice <%= msgOk ? 'ok' : 'bad' %>"><%= msg %></div><% } %>

<div class="statgrid">
  <div class="stat"><strong><%= stats.users %></strong><span><%= plural(stats.users, 'student') %></span></div>
  <div class="stat"><strong><%= stats.approved %></strong><span>published <%= plural(stats.approved, 'file') %></span></div>
  <div class="stat"><strong><%= stats.pending %></strong><span>waiting for review</span></div>
  <div class="stat"><strong><%= stats.reports %></strong><span>open reports</span></div>
  <div class="stat"><strong><%= stats.courses %></strong><span><%= plural(stats.courses, 'course') %></span></div>
  <div class="stat"><strong><%= stats.downloads %></strong><span><%= plural(stats.downloads, 'download') %></span></div>
</div>

<h2>People</h2>
<form method="get" class="inline-search">
  <input type="search" name="q" value="<%= q %>" placeholder="Search by name, email or student ID" aria-label="Search people">
  <button class="btn btn-sm" type="submit">Search</button>
</form>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Dept</th><th>Joined</th><th>Role & Actions</th></tr></thead>
    <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td><strong><%= u.name %></strong><% if (u.student_id) { %><br><span class="muted"><%= u.student_id %></span><% } %></td>
          <td><%= u.email %></td>
          <td><%= u.dept || '-' %></td>
          <td><%= fmtDate(u.created_at) %></td>
          <td style="white-space: nowrap;">
            <% if (u.id === user.id) { %>
              <span class="badge badge-admin">admin (you)</span>
            <% } else { %>
              <div style="display: inline-flex; align-items: center; gap: 8px;">
                <form action="/admin/users/<%= u.id %>/role" method="post" class="role-form" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="role" aria-label="Role for <%= u.name %>">
                    <% ['student','moderator','admin'].forEach(function(r){ %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
                  </select>
                  <button class="btn btn-ghost btn-sm" type="submit">Save</button>
                </form>
                <form action="/admin/users/<%= u.id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to permanently delete <%= u.name %> (<%= u.email %>)?');" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-danger" type="submit" style="color: #dc2626; border-color: #fca5a5; background: #fef2f2; font-weight: 600; cursor: pointer; padding: 5px 10px;">🗑️ Delete</button>
                </form>
              </div>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!users.length) { %><tr><td colspan="5" class="muted">No one matches that search.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="two admin-forms">
  <section>
    <h2>Add a department</h2>
    <form class="form" action="/admin/departments" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Code <input type="text" name="code" maxlength="8" placeholder="CSE" required></label>
      <label>Name <input type="text" name="name" maxlength="80" placeholder="Computer Science and Engineering" required></label>
      <button class="btn" type="submit">Add department</button>
    </form>
  </section>
  <section>
    <h2>Add a course</h2>
    <form class="form" action="/admin/courses" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Department
        <select name="department_id" required>
          <option value="">Select department</option>
          <% departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.code %> - <%= d.name %></option><% }) %>
        </select>
      </label>
      <div class="two">
        <label>Course code <input type="text" name="code" maxlength="14" placeholder="CSE131" required></label>
        <label>Course title <input type="text" name="title" maxlength="100" placeholder="Data Structures" required></label>
      </div>
      <button class="btn" type="submit">Add course</button>
    </form>
  </section>
</div>

<%- include('partials/footer') %>
