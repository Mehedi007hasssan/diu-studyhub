<%- include('partials/header') %>

<div class="auth">
  <h1>Change password</h1>
  <p class="muted">Update your account security password.</p>

  <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
  <% if (msg) { %><div class="notice ok"><%= msg %></div><% } %>

  <form class="form" action="/change-password" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Current password
      <input type="password" name="currentPassword" required autocomplete="current-password" placeholder="Enter current password">
    </label>

    <label>New password
      <input type="password" name="newPassword" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="At least 8 characters">
    </label>

    <label>Confirm new password
      <input type="password" name="confirmPassword" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="Re-type new password">
    </label>

    <button class="btn btn-gold" type="submit">Update password</button>
  </form>
</div>

<%- include('partials/footer') %>
