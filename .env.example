# Copy this file to .env and edit. Never share or commit .env.
PORT=3000

# REQUIRED in production: a long random string
# (generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when deployed behind HTTPS
NODE_ENV=development

# Admin accounts. Anyone who signs up with one of these emails (comma separated) becomes an admin.
# Sign up with this email yourself FIRST, before sharing the site link with anyone.
ADMIN_EMAILS=mehedishuvo644@gmail.com

# Optional: only allow these email domains to register (comma separated). Empty = any email.
# Example for DIU-only: ALLOWED_EMAIL_DOMAINS=diu.edu.bd,s.diu.edu.bd
ALLOWED_EMAIL_DOMAINS=

# Optional: where to keep the database and uploaded files (use a persistent disk when deploying)
# DB_PATH=./data/studyhub.db
# UPLOAD_DIR=./uploads

# Max upload size in MB
MAX_UPLOAD_MB=25
