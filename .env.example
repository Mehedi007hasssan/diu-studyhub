PORT=3000
NODE_ENV=development

# 1. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon)
# Example Supabase pooled connection string:
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example Neon connection string:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/diu_studyhub"

# 2. SESSION SECURITY
# In production, use a 32+ character random secret string
SESSION_SECRET=change-me-to-a-long-random-string

# 3. ADMIN PRIVILEGES
# Anyone registering with one of these emails automatically becomes an admin
ADMIN_EMAILS=mehedishuvo644@gmail.com,mehedi007shuvo@gmail.com,mehedi@diu.edu.bd,admin@diu-studyhub.edu.bd

# 4. CLOUD OBJECT STORAGE (Choose EITHER AWS S3 / Compatible OR Cloudinary)
# Option A: S3 / Cloudflare R2 / Supabase Storage S3
# S3_BUCKET=diu-studyhub-storage
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com (only needed for Cloudflare R2 / Supabase S3)

# Option B: Cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# or:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# 5. DISTRIBUTED RATE LIMITER (Upstash Redis for Vercel Serverless)
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# 6. OPTIONAL RESTRICTIONS
# University email domains restriction (e.g. diu.edu.bd,s.diu.edu.bd). Leave empty to allow all.
ALLOWED_EMAIL_DOMAINS=

# Max upload file size in megabytes
MAX_UPLOAD_MB=25
