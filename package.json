{
  "name": "diu-studyhub",
  "version": "1.0.0",
  "description": "DIU StudyHub - student-run educational resource sharing platform",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "preview": "node server.js",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "vercel-build": "prisma generate --schema=prisma/schema.prisma && node -e \"if(process.env.DATABASE_URL){require('child_process').execSync('prisma db push --schema=prisma/schema.prisma --skip-generate',{stdio:'inherit'})}\"",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:push:local": "prisma db push --schema=prisma/schema.local.prisma",
    "db:seed": "node prisma/seed.js",
    "set-role": "node scripts/set-role.js",
    "seed-admin": "node scripts/seed-admin.js",
    "change-password": "node scripts/change-password.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^6.4.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-session": "^2.1.1",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "vercel": "^64.5.0"
  }
}
